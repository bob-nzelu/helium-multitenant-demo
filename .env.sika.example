# ============================================================================
# Sika dedicated single-tenant box — environment template (DEMO/UAT phase)
# ============================================================================
# Copy to .env.sika and fill every CHANGE_ME with a freshly-minted value.
# deploy_sika.sh consumes .env.sika as `--env-file` and to render tenants.json.
#
#   cp .env.sika.example .env.sika
#   # edit .env.sika — set fresh PG/MQ passwords + HMAC + admin keys
#   ./deploy_sika.sh
#
# NEVER commit .env.sika (it is gitignored). Only this *.example is committed.
# Demo posture: license-not-required, sim-FIRS (stub Edge), legacy Core,
# 666666 one-shot login. Production hardening = a later cutover (handoff §7/§9).
# ----------------------------------------------------------------------------

# ── PostgreSQL ──────────────────────────────────────────────────────────────
PG_USER=helium
PG_PASSWORD=CHANGE_ME_pg_password
PG_DATABASE=helium

# ── RabbitMQ (core_queue + edge_queue) ──────────────────────────────────────
RABBITMQ_USER=helium
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# ── HeartBeat — Gap A: build context ────────────────────────────────────────
# Side-by-side helium-services checkout (branch sika/deploy-integration).
# deploy_sika.sh clones it as a sibling dir and exports this automatically.
HEARTBEAT_BUILD_CONTEXT=../helium-services/HeartBeat

# ── HeartBeat — Gap B: demo-phase license posture ───────────────────────────
# HB boots without a signed license and logs LICENSE_INVALID (EXPECTED).
HEARTBEAT_LICENSE_REQUIRED=false
HEARTBEAT_DEMO_MODE=true
HEARTBEAT_TIER=test
# License path is unused while LICENSE_REQUIRED=false; set at go-live (§7/§9).
HEARTBEAT_LICENSE_PATH=/etc/helium/sika/license.json

# ── HeartBeat — §4 secrets you supply ───────────────────────────────────────
# SQLCipher key for the auth DB.
HEARTBEAT_AUTH_DB_KEY=CHANGE_ME_auth_db_key_64hex
# Admin API key + admin s2s signing key — the provisioning runner authenticates
# with these (helium-services HeartBeat/scripts/provision_tenant.py).
HEARTBEAT_ADMIN_API_KEY=CHANGE_ME_hb_admin_api_key
HEARTBEAT_ADMIN_S2S_SIGNING_KEY=CHANGE_ME_admin_s2s_64hex
# User-JWT signing key path — HB auto-generates here on first boot if absent.
HEARTBEAT_JWT_PRIVATE_KEY_PATH=/app/databases/jwt_private.pem
# Test harness key hash — demo default kept (rotate at go-live). The matching
# plaintext key for the harness is the demo one already baked into the compose.
HEARTBEAT_TEST_HARNESS_KEY_HASH=786ac05ff1f90d133056376fa0a65188cab837fe4450d47d1be924bd54d017d3
# Encrypt-at-rest: leave UNSET in demo (plaintext-at-rest + a WARN). Go-live only.
# HEARTBEAT_KMS_KEY_ID=

# ── Gap C: s2s signing keys (paste AFTER first boot) ────────────────────────
# HB AUTO-GENERATES these on first boot and logs each at WARN with the exact
# env-var name. Leave EMPTY for the first `up`, then copy the logged values
# here and restart the consumers (deploy_sika.sh walks you through this).
# In this single-tenant stack only Relay consumes its key on the request path;
# legacy Core (plain HTTP to HB) and the stub Edge need no s2s key, but the
# vars are listed for completeness / go-live parity.
RELAY_S2S_SIGNING_KEY=
CORE_HEARTBEAT_S2S_SIGNING_KEY=
EDGE_S2S_SIGNING_KEY=

# ── Relay → HeartBeat (legacy bcrypt path, back-compat only) ────────────────
RELAY_HEARTBEAT_API_KEY=rl_sika_relay001
RELAY_HEARTBEAT_API_SECRET=
RELAY_RATE_LIMIT_DAILY=500

# ── Gap D: Sika tenant HMAC (fresh — NOT abbey/abmfb) ───────────────────────
# deploy_sika.sh renders config/tenants.json from tenants.sika.template.json
# using these values. Mint fresh; never reuse the abbey/abmfb committed secrets.
SIKA_API_KEY=CHANGE_ME_SIKA-2026-XXXXXXXX
SIKA_API_SECRET=CHANGE_ME_sika_api_secret_32char
# FIRS / IRN prefix. Demo phase: any stable 8-char id (sim-FIRS does not verify).
SIKA_SERVICE_ID=CHANGE_ME_SIKAID8
SIKA_FIRS_SERVICE_ID=CHANGE_ME_SIKAID8
