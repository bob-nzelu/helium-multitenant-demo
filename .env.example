# ── PostgreSQL ──────────────────────────────────────────
PG_USER=helium
PG_PASSWORD=helium_demo_2026
PG_DATABASE=helium

# ── Relay ───────────────────────────────────────────────
RELAY_DEV_API_KEY=
RELAY_DEV_API_SECRET=
RELAY_INTERNAL_SERVICE_TOKEN=dev-token-123
RELAY_RATE_LIMIT_DAILY=500

# Relay → HeartBeat service-to-service auth.
# RELAY_HEARTBEAT_API_KEY pairs with RELAY_S2S_SIGNING_KEY for §3.3 HMAC
# signing (post-2026-05-08 cutover per HMAC_S2S_MIGRATION_SPEC.md).
# RELAY_HEARTBEAT_API_SECRET is retained for back-compat with the
# legacy bcrypt path; HB no longer reads it on the request path. Safe
# to leave empty in fresh deploys.
# RELAY_S2S_SIGNING_KEY is the per-service 64-hex HMAC key generated by
# HB's bootstrap and emitted as a WARNING line in HB's startup log
# (see RELAY_NEXT_STEPS_NOTE_2026_05_09 §1.3). Operator copies it here
# once. Never commit a real value to git.
RELAY_HEARTBEAT_API_KEY=
RELAY_HEARTBEAT_API_SECRET=
RELAY_S2S_SIGNING_KEY=

